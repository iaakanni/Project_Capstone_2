   "source": [
    "# Fix dataset so each Order ID has only one customer\n",
    "\n",
    "# Find most frequent customer per Order ID\n",
    "customer_fix = (\n",
    "    cp2_df.groupby([\"Order_ID\", \"Customer_Name\"])\n",
    "    .size()\n",
    "    .reset_index(name=\"count\")\n",
    "    .sort_values([\"Order_ID\", \"count\"], ascending=[True, False])\n",
    "    .drop_duplicates(\"Order_ID\")\n",
    ")\n",
    "\n",
    "# Keep only order_id and corrected customer\n",
    "customer_fix = customer_fix[[\"Order_ID\", \"Customer_Name\"]]\n",
    "\n",
    "# Remove old customer_name column\n",
    "cp2_df = cp2_df.drop(\"Customer_Name\", axis=1)\n",
    "\n",
    "# Merge corrected customer names back\n",
    "cp2_df = cp2_df.merge(customer_fix, on=\"Order_ID\", how=\"left\")\n",
    "\n",
    "# Preview cleaned dataset\n",
    "cp2_df.head()"
   ]
